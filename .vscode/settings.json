{
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/__pycache__": true,
    },
    "editor.rulers": [
        120,
        180
    ],
    "editor.stickyScroll.enabled": false,
    "workbench.tree.enableStickyScroll": false,
    "explorer.autoReveal": false,
}